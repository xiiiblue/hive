  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.0",
    "markdown-it": "15.0.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
