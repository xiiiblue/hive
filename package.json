{
  "name": "hive-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "蜂巢：企业内网员工数字分身平台，产品、架构与使用文档",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
