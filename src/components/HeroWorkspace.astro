---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { url } from '../lib/content';
---
<figure class="hero-workspace">
  <div class="workspace-pattern" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
  </div>
  <div class="workspace-stage-label"><Logo /><span>员工工作台</span></div>
  <div class="hero-product-window">
    <button type="button" data-image-zoom aria-label="放大员工工作台对话界面">
      <img src={url('/media/manuals/employee/02-answer-files.png')} alt="员工工作台中的对话记录、工作过程和文件" fetchpriority="high" />
      <span class="zoom-label" aria-hidden="true"><Icon name="search" size={17} />放大查看</span>
    </button>
  </div>
  <figcaption>真实界面 · 合成示例</figcaption>
</figure>
