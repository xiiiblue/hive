---
import Icon from './Icon.astro';
import { url } from '../lib/content';
---
<figure class="system-map" aria-label="蜂巢总体架构">
  <div class="map-main">
    <section class="map-column" aria-label="使用入口">
      <h3>使用入口</h3>
      <div class="map-nodes">
        <a class="map-node" href={url('/docs/employee/overview/')}><Icon name="workspace" size={20} /><span><strong>员工工作台与手机聊天</strong><small>发起任务、查看结果</small></span></a>
        <a class="map-node" href={url('/docs/admin/overview/')}><Icon name="shield" size={20} /><span><strong>管理员控制台</strong><small>分配资源、管理运行</small></span></a>
        <a class="map-node" href={url('/docs/developers/open-api/')}><Icon name="code" size={20} /><span><strong>开放API</strong><small>已获准的系统代员工发起任务</small></span></a>
      </div>
    </section>
    <div class="map-connector" aria-hidden="true"></div>
    <section class="map-column map-column-core" aria-label="蜂巢平台">
      <h3>蜂巢平台</h3>
      <div class="map-nodes">
        <a class="map-node" href={url('/docs/architecture/overview/')}><Icon name="layers" size={20} /><span><strong>平台核心 Hive Core</strong><small>核对身份、管理授权和任务状态</small></span></a>
        <div class="map-internal"><small>数据库和对象存储保留平台状态与资源</small><small>运行环境管理服务负责启停执行环境</small></div>
      </div>
    </section>
    <div class="map-connector" aria-hidden="true"></div>
    <section class="map-column map-column-runtime" aria-label="员工工作空间">
      <h3>员工工作空间</h3>
      <div class="map-nodes">
        <a class="map-node" href={url('/docs/architecture/workspace/')}><Icon name="workspace" size={20} /><span><strong>个人执行环境</strong><small>Hive Pi或OpenCode推进当前任务</small></span></a>
        <div class="map-internal"><small>个人文件、技能与工具按权限使用</small><small>工作资料留在相应的文件目录</small></div>
      </div>
    </section>
  </div>
  <div class="map-paths">
    <div class="map-path">
      <span class="map-path-name"><Icon name="layers" size={18} />模型请求</span>
      <a href={url('/docs/architecture/model-gateway/')}>通过模型网关访问模型服务</a>
    </div>
    <div class="map-path">
      <span class="map-path-name"><Icon name="shield" size={18} />业务访问</span>
      <a href={url('/docs/developers/identity/')}>业务系统核验身份并检查权限</a>
    </div>
  </div>
  <figcaption>执行环境中的模型请求通过模型网关转发。业务工具或面板按所在系统的授权访问对应业务。</figcaption>
</figure>

<style>
.system-map {
  margin: 0;
  padding: clamp(16px, 3vw, 34px);
  border: 1px solid #2d4568;
  border-radius: 22px;
  background: #0d1b33;
  color: #f6f8ff;
}
.map-main { display: grid; grid-template-columns: 1fr 42px 1.12fr 42px 1.08fr; align-items: start; }
.map-column {
  min-width: 0;
  padding: 15px;
  border: 1px solid #35496b;
  border-radius: 13px;
  background: #142441;
}
.map-column-core { background: #182b4b; }
.map-column-runtime { background: #1b345b; border-color: #5277a6; }
.map-column h3 { font-size: 15px; letter-spacing: 0; margin: 0 0 13px; color: #bbd0f0; }
.map-nodes { display: grid; gap: 8px; }
.map-node {
  display: flex;
  gap: 9px;
  align-items: flex-start;
  padding: 10px;
  background: #0d1b32;
  border: 1px solid #365279;
  border-radius: 8px;
  transition: background .18s, border-color .18s;
}
.map-node:hover { border-color: #a2c8ff; background: #213b61; }
.map-node > :global(svg) { color: #b0d0ff; }
.map-node strong, .map-node small { display: block; }
.map-node strong { font-size: 15px; font-weight: 650; line-height: 1.55; }
.map-node small, .map-internal small { color: #b7c9e5; font-size: 13px; line-height: 1.6; margin-top: 3px; }
.map-internal { display: grid; gap: 8px; padding: 6px 2px 1px; }
.map-internal small { border-left: 2px solid #668fc8; padding-left: 10px; }
.map-connector { position: relative; background: #7596c7; height: 1px; margin-top: 84px; }
.map-connector::after {
  position: absolute;
  content: "";
  right: 2px;
  width: 7px;
  height: 7px;
  top: -3px;
  transform: rotate(45deg);
  border-top: 1px solid #aad0ff;
  border-right: 1px solid #aad0ff;
}
.map-paths { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
.map-path {
  border: 1px solid #365279;
  border-radius: 10px;
  padding: 12px 13px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4px 14px;
  font-size: 14px;
}
.map-path-name { display: inline-flex; align-items: center; gap: 7px; font-weight: 650; color: #b4d3ff; }
.map-path a { text-decoration: underline; text-underline-offset: 4px; }
.system-map figcaption { margin-top: 14px; color: #b7c9e5; font-size: 13px; }
.system-map :is(a, button):focus-visible { outline-color: #b4d3ff; }
@media (max-width: 820px) {
  .map-main { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .map-connector { margin: 0 auto; width: 1px; height: 23px; }
  .map-connector::after { right: -3px; top: auto; bottom: 2px; transform: rotate(135deg); }
}
@media (max-width: 500px) {
  .map-paths { grid-template-columns: 1fr; }
}
</style>
