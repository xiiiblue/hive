---
import Icon from './Icon.astro';
---
<figure class="workspace-concept" aria-label="员工数字分身中的身份、工作空间、任务和业务权限">
  <div class="workspace-layer"><Icon name="person" size={21} /><strong>企业员工身份</strong><small>登录后识别当前员工</small></div>
  <div class="workspace-joint" aria-hidden="true"></div>
  <section class="workspace-frame">
    <h3><Icon name="workspace" size={23} />员工工作空间</h3>
    <ul>
      <li><strong>对话与任务</strong><small>记住上下文，记录执行结果</small></li>
      <li><strong>个人文件</strong><small>保存原始资料与工作成果</small></li>
      <li><strong>技能与工具</strong><small>使用已有做法和获准的工具</small></li>
    </ul>
  </section>
  <div class="workspace-joint" aria-hidden="true"></div>
  <div class="workspace-layer"><Icon name="shield" size={21} /><strong>企业业务系统</strong><small>核验身份并判断权限</small></div>
</figure>

<style>
.workspace-concept { margin: 0; padding: clamp(13px, 3vw, 27px); border-radius: 19px; background: #101f3a; color: #eff5ff; }
.workspace-layer { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 9px; padding: 12px; background: #1b3155; border: 1px solid #466191; border-radius: 8px; }
.workspace-layer small { margin-left: auto; }
.workspace-frame { padding: 15px; border: 1px solid #5578b5; border-radius: 11px; background: #1c375f; }
.workspace-frame h3 { display: flex; gap: 8px; align-items: center; font-size: 1.1rem; }
.workspace-frame ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; list-style: none; padding: 0; margin: 12px 0 0; }
.workspace-frame li { display: grid; align-content: start; gap: 5px; padding: 8px; border: 1px solid #466191; border-radius: 5px; background: #132642; line-height: 1.55; }
.workspace-frame li strong { font-size: .875rem; }
.workspace-concept small { display: block; font-size: .8125rem; color: #c4d3ed; }
.workspace-concept :global(svg) { flex-shrink: 0; color: #bdd5ff; }
.workspace-joint { width: 2px; height: 20px; background: #799dd4; margin: auto; }
@media (max-width: 460px) {
  .workspace-frame ul { grid-template-columns: 1fr; }
  .workspace-layer small { margin-left: 0; flex-basis: 100%; }
}
</style>
