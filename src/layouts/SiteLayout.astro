---
import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import Search from '../components/Search.astro';import '../styles/global.css';import {url} from '../lib/content';
interface Props {title?:string;description?:string;kind?:string;}
const {title='蜂巢 · 企业内网中的员工数字分身',description='认识蜂巢的产品、架构与设计，阅读员工和管理员操作手册，了解开放API、业务系统、Skill、MCP与业务面板对接。',kind='website'}=Astro.props;
const canonical=new URL(/\/404\/?$/.test(Astro.url.pathname)?url('/404.html'):Astro.url.pathname,'https://www.bluexiii.com');
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light dark"/><meta name="theme-color" content="#f8faff"/><title>{title}</title><meta name="description" content={description}/>{/\/404\/?$/.test(Astro.url.pathname)&&<meta name="robots" content="noindex"/>}<link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={url('/favicon.svg')}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={kind}/><meta property="og:locale" content="zh_CN"/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://www.bluexiii.com/hive/media/social-cover.png"/><meta name="twitter:card" content="summary_large_image"/><script is:inline>try{const t=localStorage.getItem('hive-site-theme');document.documentElement.dataset.theme=t==='dark'||(!t&&matchMedia('(prefers-color-scheme:dark)').matches)?'dark':'light';}catch{}</script></head><body><a class="skip-link" href="#main-content">跳到主要内容</a><Header/><main id="main-content"><slot/></main><Footer/><Search/><script>import '../lib/client';</script></body></html>
