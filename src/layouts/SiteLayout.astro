---
import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import Search from '../components/Search.astro';import '../styles/global.css';import {url} from '../lib/content';
interface Props {title?:string;description?:string;kind?:string;}
const {title='蜂巢 · 企业内网员工AI工作平台',description='为每名员工提供独立的持久工作空间与受控业务协同能力。认识蜂巢产品与架构，查阅员工与管理员手册，了解开放API、统一身份、Skill、MCP与业务面板对接。',kind='website'}=Astro.props;
const canonical=new URL(/\/404\/?$/.test(Astro.url.pathname)?url('/404.html'):Astro.url.pathname,'https://www.bluexiii.com');
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="color-scheme" content="light"/><meta name="theme-color" content="#ffffff"/><title>{title}</title><meta name="description" content={description}/>{/\/404\/?$/.test(Astro.url.pathname)&&<meta name="robots" content="noindex"/>}<link rel="canonical" href={canonical}/><link rel="icon" type="image/png" sizes="94x94" href={url('/media/hive-logo.png')}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content={kind}/><meta property="og:locale" content="zh_CN"/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://www.bluexiii.com/hive/media/social-cover.png"/><meta name="twitter:card" content="summary_large_image"/></head><body><a class="skip-link" href="#main-content">跳到主要内容</a><Header/><main id="main-content"><slot/></main><Footer/><Search/><script>import '../lib/client';</script></body></html>
