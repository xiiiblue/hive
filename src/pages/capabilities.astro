---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import postcss from 'postcss';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getDocs, renderDoc } from '../lib/content';

const doc = getDocs().find(item => item.slug === 'product/capabilities')!;
const guide = renderDoc(doc.body);
const original = readFileSync(resolve('public/media/diagrams/capabilities.html'), 'utf8');
const map = original.match(/<main\b[^>]*>([\s\S]*?)<\/main>/i)?.[1];
const style = original.match(/<style>([\s\S]*?)<\/style>/i)?.[1];
const script = original.match(/<script>([\s\S]*?)<\/script>/i)?.[1];
if (!map || !style || !script) throw new Error('功能架构图原件缺少正文、样式或筛选脚本');

// 把离线原图的页面级样式限定在图中，官网导航、搜索和页脚沿用各自的样式。
const css = postcss.parse(style);
const sharedStyles = new Set(['font-family', '--ink', '--muted', '--line', '--accent', '--soft', '--shadow']);
css.walkRules(rule => {
  if (rule.parent?.type === 'root') {
    if (rule.selector === ':root') {
      rule.walkDecls(declaration => {
        if (sharedStyles.has(declaration.prop)) declaration.remove();
      });
    }
    if (rule.selector === '.map-header') {
      rule.walkDecls(/^(padding|margin-bottom)$/, declaration => { declaration.remove(); });
    }
    if (rule.selector === 'main' || rule.selector === 'h1') {
      rule.remove();
      return;
    }
  }
  rule.selectors = rule.selectors.map(selector => {
    if (selector === ':root' || selector === 'body') return '.capabilities-sheet';
    if (selector === 'main') return '.capabilities-sheet .map-canvas';
    return '.capabilities-sheet ' + selector;
  });
});
---
<SiteLayout title={doc.title + ' · 蜂巢'} description={doc.description}>
  <style is:inline set:html={css.toString()}></style>
  <div class="capabilities-sheet">
    <div class="map-canvas container" id="top">
      <Fragment set:html={map} />
      <section class="capability-guide" id="按需要查找功能" aria-labelledby="按任务查操作手册" set:html={guide.html} />
    </div>
  </div>
  <script is:inline set:html={script}></script>
</SiteLayout>

<style>
  .capabilities-sheet {
    --page: var(--bg);
    --surface: var(--paper);
    --tile: var(--soft);
  }
  .map-canvas { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .capabilities-sheet :global(.diagram-actions .button) { min-height: 2.75rem; padding: .5rem .85rem; }
  .capabilities-sheet :global(.catalog > .bucket:nth-child(odd of :not([hidden])):nth-last-child(1 of :not([hidden]))) {
    grid-column: 1 / -1;
  }
  .capabilities-sheet :global(#features > .back) { text-align: right; margin-top: .75rem; }
  .capabilities-sheet :global(#features > .back a) { text-decoration: underline; }
  .capability-guide {
    display: grid;
    grid-template-columns: 8.35rem minmax(0, 1fr);
    gap: .75rem 1rem;
    border-top: 1px solid var(--line);
    padding-block: 1.5rem .75rem;
    margin-top: 1.25rem;
  }
  .capability-guide :global(h2) { grid-column: 1 / -1; margin-bottom: .25rem; }
  .capability-guide :global(h3) { padding-top: .7rem; font-size: .9375rem; }
  .capability-guide :global(ul) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .capability-guide :global(li:only-child) { grid-column: 1 / -1; }
  .capability-guide :global(li a) {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    height: 100%;
    padding: .5rem .75rem;
    border: 1px solid var(--line);
    border-radius: .4rem;
    background: var(--surface);
    font-size: .9rem;
    text-decoration: underline;
    text-decoration-color: transparent;
  }
  .capability-guide :global(li a:hover) { border-color: var(--accent); text-decoration-color: currentColor; }
  .capability-guide :global(h2:not(:first-child)) {
    margin: .5rem 0 0;
    padding-top: .85rem;
    border-top: 1px solid var(--line);
    font-size: .9375rem;
  }
  .capability-guide :global(p) { grid-column: 1 / -1; font-size: .9rem; }
  @media screen and (min-width: 74rem) {
    .capability-guide :global(ul:first-of-type) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media screen and (min-width: 62rem) {
    .capabilities-sheet :global(.bucket:nth-child(odd of :not([hidden])):nth-last-child(1 of :not([hidden])) > .entries:has(> .entry:nth-child(2 of :not([hidden])))) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .capabilities-sheet :global(.bucket:nth-child(odd of :not([hidden])):nth-last-child(1 of :not([hidden])) .entry:nth-child(-n+2 of :not([hidden]))) { border-top: 0; }
    .capabilities-sheet :global(.bucket:nth-child(odd of :not([hidden])):nth-last-child(1 of :not([hidden])) .entry:nth-child(even of :not([hidden]))) { border-inline-start: 1px solid var(--line); }
  }
  @media (max-width: 58rem) {
    .capability-guide { grid-template-columns: minmax(0, 1fr); gap: .6rem; }
    .capability-guide :global(h3) { padding-top: .25rem; }
    .capability-guide :global(ul) { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: .35rem; }
  }
  @media (max-width: 35rem) {
    .capability-guide :global(ul) { grid-template-columns: minmax(0, 1fr); }
  }
  @media print {
    .map-canvas { width: 100%; padding: 0; }
    .capabilities-sheet :global(.map-header) { padding: 0; }
    .capability-guide { display: none; }
  }
</style>
