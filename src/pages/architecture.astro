---
import SiteLayout from '../layouts/SiteLayout.astro';import Icon from '../components/Icon.astro';import ArchitectureGraph from '../components/ArchitectureGraph.astro';import DocCards from '../components/DocCards.astro';import {url,sectionDocs} from '../lib/content';
const layers=[{key:'control',label:'控制与状态',title:'先确定谁在做什么。',text:'Core维护员工、对话、任务、资源分配和运行状态，把需要一致处理的事实留在数据库中，再把容器相关操作交给Runtime Manager。',detail:'Core · PostgreSQL · 任务调度',link:'overview'},{key:'runtime',label:'员工执行',title:'短时任务，长期工作空间。',text:'每名员工拥有独占的执行环境。Hive Pi或OpenCode为单次任务推进工作，文件、依赖和会话数据在任务结束后继续保留。',detail:'Runtime Manager · Docker · Workspace',link:'workspace'},{key:'model',label:'模型访问',title:'模型Key留在受控入口。',text:'Model Gateway负责模型路由、运行身份核验和调用归因。模型上游Key不会直接发进员工运行环境。',detail:'模型访问码 · 固定路由 · 用量记录',link:'model-gateway'},{key:'business',label:'业务身份',title:'身份由蜂巢证明，权限由业务方判断。',text:'Skill或业务面板直接访问业务系统；业务网关在线核验蜂巢短期身份，关联本系统账号，再检查角色和数据权限。',detail:'系统资格 · 短期身份 · 业务权限',link:'security'}];
---
<SiteLayout title="架构与设计 · 蜂巢" description="了解蜂巢四层架构、任务生命周期、持久工作空间、模型网关与企业业务身份边界。"><section class="page-intro container"><span class="eyebrow">ARCHITECTURE / 把结构讲明白</span><h1>让能力自由发挥，<br/><em>让边界清楚可见。</em></h1><div class="page-intro-bottom"><p>模块化单体控制面，独立宿主编排，员工独占执行环境。<br/>模型访问与业务访问分开，状态与工作资产各有归属。</p><a class="button primary" href={url('/docs/architecture/overview/')}>阅读架构导读<Icon name="arrow" size={18}/></a></div></section><section class="container"><ArchitectureGraph/></section><section class="section container" data-tabs><div class="section-heading"><div><span class="eyebrow">FOUR RESPONSIBILITIES</span><h2>不必先记住所有组件，<br/>先看它们各自负责什么。</h2></div></div><div class="architecture-explorer"><div role="tablist" aria-label="架构职责">{layers.map((layer,i)=><button type="button" role="tab" id={'layer-'+layer.key} aria-controls={'layer-panel-'+layer.key} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}><span>0{i+1}</span>{layer.label}<Icon name="arrow" size={18}/></button>)}</div>{layers.map((layer,i)=><div role="tabpanel" id={'layer-panel-'+layer.key} aria-labelledby={'layer-'+layer.key} hidden={i!==0}><span class="eyebrow">{layer.detail}</span><h3>{layer.title}</h3><p>{layer.text}</p><a class="inline-link" href={url('/docs/architecture/'+layer.link+'/')}>深入理解这一部分<Icon name="arrow" size={18}/></a></div>)}</div></section><section class="principles section"><div class="container lifecycle"><div><span class="eyebrow">A TASK, END TO END</span><h2>一次任务的旅程。</h2><p>对话保存上下文，任务记录一次执行。<br/>浏览器短暂断线，与任务是否结束，是两件事。</p><a class="inline-link" href={url('/docs/architecture/task-lifecycle/')}>逐步理解任务生命周期<Icon name="arrow" size={18}/></a></div><ol>{[['接收要求','员工在对话或通过开放API发起一项工作。'],['核对与准备','检查身份、资源、模型与工作空间，进入等待或运行。'],['执行与记录','智能体调用模型和工具，过程事件持续写回。'],['结束与保留','记录完成、失败或取消状态，文件与会话继续保留。']].map(([title,text],i)=><li><span>0{i+1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section><section class="section container"><div class="section-heading"><h2>从一张图，读到设计细节。</h2></div><DocCards docs={sectionDocs('architecture')}/></section></SiteLayout>
