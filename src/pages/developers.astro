---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import DocCards from '../components/DocCards.astro';
import { url, sectionDocs } from '../lib/content';

const paths = [
  {
    number: '01',
    title: '从业务后端调用智能体',
    label: '开放API',
    text: '一次性JSON、SSE流式输出，或创建异步长任务。Key固定员工、执行引擎和业务范围。',
    link: 'open-api',
    code: 'POST /api/openai/v1/chat/completions\nPOST /api/open/v1/runs',
  },
  {
    number: '02',
    title: '让业务系统认识当前员工',
    label: '统一身份',
    text: '网页使用OIDC完成身份登录；业务网关逐请求核验短期Token，再按自身账号和权限处理。',
    link: 'identity',
    code: 'OIDC + PKCE S256\nPOST /identity/introspect',
  },
  {
    number: '03',
    title: '交付做法、工具和业务页面',
    label: 'Skill · MCP · 面板',
    text: '用Skill保存做事方法，用MCP提供远程工具，用静态面板组织页面操作。',
    link: 'skills',
    code: 'SKILL.md / scripts / references\nwindow.hivePanel.getSystemContext(...)',
  },
];
---

<SiteLayout
  title="开发与对接 · 蜂巢"
  description="开放API、异步任务、统一身份、Skill、MCP、业务面板与HiveBridge桌面开发者工具指南。"
>
  <section class="page-intro container">
    <span class="eyebrow">开放接口与能力交付</span>
    <h1>开发对接</h1>
    <div class="page-intro-bottom">
      <p>
        从智能体调用、员工短期身份核验或能力交付选择起点，理清接口契约与权限责任边界。
      </p>
      <a class="button primary" href={url('/docs/developers/overview/')}>
        接入快速开始<Icon name="arrow" size={18} />
      </a>
    </div>
  </section>

  <section class="container developer-paths">
    {
      paths.map((path, idx) => (
        <article data-reveal data-spotlight style={`--reveal-delay: ${idx * 70}ms`}>
          <div>
            <span class="eyebrow">
              {path.number} / {path.label}
            </span>
            <h2>{path.title}</h2>
            <p>{path.text}</p>
            <a
              class="inline-link"
              href={url('/docs/developers/' + path.link + '/')}
            >
              阅读对接指南<Icon name="arrow" size={18} />
            </a>
          </div>
          <pre><code>{path.code}</code></pre>
        </article>
      ))
    }

    <article class="developer-tool-feature" data-reveal data-spotlight style="--reveal-delay: 210ms">
      <div>
        <span class="eyebrow">04 / 桌面开发者工具</span>
        <h2>用HiveBridge一站式发布与管理</h2>
        <p>
          开源跨平台原生桌面工具（支持Mac与Windows）。登录后凭据加密保存在本机，可一键切换多套环境，完成业务面板同步与安全发布、企业Skill选目录自动打包上传，以及知识库文档批量管理。
        </p>
        <div class="developer-tool-actions">
          <a class="inline-link" href={url('/docs/developers/hive-bridge/')}>
            阅读使用指南<Icon name="arrow" size={18} />
          </a>
          <a
            class="inline-link"
            href="https://github.com/xiiiblue/hive-bridge/releases"
            target="_blank"
            rel="noopener noreferrer"
          >
            下载桌面端（GitHub）<Icon name="arrow" size={18} />
          </a>
        </div>
      </div>
      <a
        class="developer-tool-shot"
        href={url('/docs/developers/hive-bridge/')}
        aria-label="查看HiveBridge使用指南"
      >
        <img
          src={url('/media/hive-bridge/desktop-selection.png')}
          alt="HiveBridge桌面开发者工具界面：左侧切换多环境，右侧管理业务面板、企业Skill与知识库文档"
          loading="lazy"
        />
      </a>
    </article>
  </section>

  <section class="section principles">
    <div class="container developer-note" data-reveal data-spotlight>
      <Icon name="shield" size={36} />
      <div>
        <h2>
          把身份带过去，<br />
          把业务权限留在业务系统。
        </h2>
        <p>
          系统资格、资源分配和业务权限分别检查。开放API
          Key留在服务端；短期业务身份不写入对话、日志或持久文件。网站上的示例地址和参数只用于说明协议。
        </p>
      </div>
      <a class="inline-link" href={url('/docs/developers/identity/')}>
        阅读身份与授权指南<Icon name="arrow" size={18} />
      </a>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div>
        <span class="eyebrow">REFERENCE &amp; GUIDES</span>
        <h2>
          从接口到实现，<br />
          按主题查阅。
        </h2>
      </div>
      <p>
        示例说明前提、结果与错误处理，<br />
        不依赖内部联调环境。
      </p>
    </div>
    <DocCards docs={sectionDocs('developers')} />
  </section>
</SiteLayout>
