---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { url, sectionDocs, docUrl } from '../lib/content';

const books = [
  {
    id: 'employee',
    badge: '面向全体员工 · 10章图文指南',
    title: '员工工作台',
    description: '从首次登录、发起对话与核对文件开始，逐步掌握Skill、业务面板、个人机器人与定时任务。',
    image: 'employee/02-answer-files.png',
    icon: 'workspace',
  },
  {
    id: 'admin',
    badge: '面向平台管理员 · 10章配置指南',
    title: '管理员控制台',
    description: '从组织账号与岗位能力组入手，统一管理业务系统、企业Skill、模型渠道、预算与运维备份。',
    image: 'admin/01-overview.png',
    icon: 'shield',
  },
];
---
<SiteLayout title="操作手册 · 蜂巢" description="按角色阅读蜂巢员工工作台与管理员控制台手册，查看当前界面、操作步骤和结果。">
  <section class="page-intro container">
    <span class="eyebrow">角色操作指南</span>
    <h1>操作手册</h1>
    <div class="page-intro-bottom">
      <p>按你的日常角色选择手册。首次使用建议先看导读与前两章；遇到具体操作问题可直接检索或点击下方章节。</p>
      <button class="button primary" type="button" data-open-search><Icon name="search" size={18} />搜索具体操作</button>
    </div>
  </section>
  <div class="container handbook-grid">
    {books.map((book, bookIdx) => (
      <section class="handbook-card" data-reveal data-spotlight style={`--reveal-delay: ${bookIdx * 100}ms`}>
        <div class="handbook-card-heading">
          <div class="handbook-top-row">
            <span class="handbook-icon"><Icon name={book.icon} size={22} /></span>
            <span class="handbook-badge">{book.badge}</span>
          </div>
          <h2>{book.title}</h2>
          <p>{book.description}</p>
          <a class="inline-link" href={url('/docs/' + book.id + '/overview/')}>从手册导读开始<Icon name="arrow" size={16} /></a>
        </div>
        <figure class="handbook-preview">
          <button type="button" data-image-zoom aria-label={'放大' + book.title + '界面'}>
            <img src={url('/media/manuals/' + book.image)} alt={book.title + '演示界面'} loading="lazy" decoding="async" />
            <span class="preview-zoom-pill" aria-hidden="true"><Icon name="search" size={14} />放大查看</span>
          </button>
          <figcaption>真实界面 · 合成示例（点击可放大）</figcaption>
        </figure>
        <ol class="handbook-chapters">
          {sectionDocs(book.id).filter(doc => !doc.slug.endsWith('/overview')).map((doc, idx) => (
            <li>
              <a href={docUrl(doc)}>
                <span class="chap-num">{String(idx + 1).padStart(2, '0')}</span>
                <span class="chap-title">{doc.title}</span>
                <Icon name="chevron" size={16} />
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
  <section class="end-note container">
    <p>可见入口与可用能力以你所在企业的实际部署与能力组配置为准。</p>
    <a class="inline-link" href={url('/capabilities/#按需要查找功能')}>按功能模块反查对应章节<Icon name="arrow" size={16} /></a>
  </section>
</SiteLayout>

<style>
.handbook-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(16px, 2.6vw, 28px);
}
.handbook-card {
  min-width: 0;
  border: 1px solid var(--line);
  border-radius: var(--radius-xl);
  overflow: clip;
  background: var(--paper);
  box-shadow: var(--shadow-sm);
}
.handbook-card-heading {
  padding: clamp(22px, 3vw, 34px);
  background: linear-gradient(180deg, #fafafa 0%, #f4f4f5 100%);
  border-bottom: 1px solid var(--line);
}
.handbook-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}
.handbook-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 11px;
  background: var(--accent-soft);
  border: 1px solid var(--accent-border);
  color: var(--accent);
}
.handbook-badge {
  padding: 4px 10px;
  border-radius: 999px;
  background: var(--paper);
  border: 1px solid var(--line);
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--muted);
}
.handbook-card-heading h2 {
  margin-bottom: 8px;
  font-size: clamp(1.55rem, 2.6vw, 2.1rem);
}
.handbook-card-heading p {
  min-height: 3.4em;
  color: var(--muted);
  font-size: 0.94rem;
  line-height: 1.72;
}
.handbook-card-heading a {
  margin-top: 16px;
}
.handbook-preview {
  margin: 0;
  padding: clamp(14px, 2vw, 22px);
  background: #fafafa;
  border-bottom: 1px solid var(--line);
}
.handbook-preview button {
  position: relative;
  width: 100%;
  display: block;
  cursor: zoom-in;
  aspect-ratio: 1.68;
  padding: 0;
  background: var(--paper);
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid var(--line-strong);
  box-shadow: var(--shadow-xs);
}
.handbook-preview img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}
.handbook-preview button:hover img {
  transform: scale(1.02);
}
.preview-zoom-pill {
  position: absolute;
  right: 10px;
  bottom: 10px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 10px;
  border-radius: 8px;
  background: rgba(24, 24, 27, 0.84);
  color: #ffffff;
  font-size: 0.76rem;
  font-weight: 550;
  opacity: 0;
  transform: translateY(4px);
  transition: opacity 0.2s ease, transform 0.2s ease;
}
.handbook-preview button:hover .preview-zoom-pill,
.handbook-preview button:focus-visible .preview-zoom-pill {
  opacity: 1;
  transform: translateY(0);
}
.handbook-preview figcaption {
  font-size: 0.78rem;
  color: var(--muted);
  margin-top: 8px;
}
.handbook-chapters {
  list-style: none;
  padding: 8px clamp(16px, 2.2vw, 28px) 18px;
  margin: 0;
}
.handbook-chapters li:not(:last-child) {
  border-bottom: 1px solid var(--soft);
}
.handbook-chapters a {
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) 16px;
  align-items: center;
  gap: 10px;
  padding: 12px 10px;
  margin-inline: -10px;
  border-radius: 8px;
  font-size: 0.94rem;
  font-weight: 550;
  transition: color 0.15s ease, background 0.15s ease;
}
.handbook-chapters a:hover {
  background: var(--bg-subtle);
}
.chap-num {
  font: 600 0.75rem/1 ui-monospace, SFMono-Regular, monospace;
  color: var(--subtle);
}
.handbook-chapters a :global(svg) {
  color: var(--subtle);
  transition: transform 0.15s ease, color 0.15s ease;
}
.handbook-chapters a:hover,
.handbook-chapters a:hover .chap-num,
.handbook-chapters a:hover :global(svg) {
  color: var(--accent);
}
.handbook-chapters a:hover :global(svg) {
  transform: translateX(3px);
}
.end-note {
  padding-top: 38px;
}
@media (max-width: 760px) {
  .handbook-grid {
    grid-template-columns: minmax(0, 1fr);
  }
  .handbook-card-heading p {
    min-height: 0;
  }
}
</style>
