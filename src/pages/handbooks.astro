---
import SiteLayout from '../layouts/SiteLayout.astro';import Icon from '../components/Icon.astro';import {url,sectionDocs,docUrl} from '../lib/content';
const books=[{id:'employee',label:'EMPLOYEE WORKBENCH',title:'员工工作台',description:'从一项具体工作出发，学会对话、技能、文件、面板和自动化。',image:'employee/02-answer-files.png',number:'01',screens:71},{id:'admin',label:'ADMIN CONSOLE',title:'管理员控制台',description:'先理解为什么要管理，再掌握人员、企业能力、模型和平台运行。',image:'admin/01-overview.png',number:'02',screens:60}];
---
<SiteLayout title="图文操作手册 · 蜂巢" description="图文讲解蜂巢员工工作台与管理员控制台，说明为什么有这个功能、怎样操作及如何判断结果。"><section class="page-intro container"><span class="eyebrow">HANDBOOKS / 从理解到操作</span><h1>先明白为什么，<br/><em>再掌握怎样做。</em></h1><p>不需要先了解系统架构，也能找到自己的第一步。<br/>两类角色，两本图文手册，把操作、影响和结果讲清楚。</p></section><div class="container handbook-shelves">{books.map(book=><section class={'handbook-volume '+book.id}><div class="volume-cover"><span>{book.label}</span><h2>{book.title}<br/>操作手册</h2><p>{book.description}</p><div><strong>{book.number}</strong><small>10个使用章节<br/>{book.screens}张界面截图</small></div><a class="button" href={url('/docs/'+book.id+'/overview/')}>开始阅读<Icon name="arrow" size={18}/></a></div><div class="volume-contents"><div class="volume-preview"><img src={url('/media/manuals/'+book.image)} alt={book.title+'演示界面'} width="1440" height="1100" loading="lazy"/></div><ol>{sectionDocs(book.id).filter(d=>d.order>0).map(doc=><li><a href={docUrl(doc)}><span>{String(doc.order).padStart(2,'0')}</span>{doc.title}<Icon name="arrow" size={15}/></a></li>)}</ol></div></section>)}</div><section class="end-note container"><span class="eyebrow">关于图片与适用范围</span><p>两册共131张界面截图和2张概念图，均按当前页面整理。<br/>图中人员、模型、文件、渠道和业务记录为合成资料；操作结果仍需在自己的部署中核对。</p><a class="inline-link" href={url('/docs/')}><Icon name="search" size={17}/>也可以按关键词搜索具体操作</a></section></SiteLayout>
