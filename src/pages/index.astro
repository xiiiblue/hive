---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import HeroWorkspace from '../components/HeroWorkspace.astro';
import ArchitectureGraph from '../components/ArchitectureGraph.astro';
import {url,getDocs,docUrl} from '../lib/content';
import '../styles/home.css';
const examples=[
  {key:'report',label:'把资料整理成周报',title:'交代目标，查看过程，\n带走一份工作成果。',text:'提供工单、纪要或表格，让智能体读取资料、调用工具、整理报告。核对内容后，结果文件留在自己的工作空间，下一次还能接着用。',image:'employee/02-answer-files.png',link:'/docs/employee/02-conversations/',tags:['对话与工具调用','文件与结果核对']},
  {key:'skills',label:'把做法变成技能',title:'做成一次的工作，\n成为下一次的起点。',text:'从技能广场选择可用方法，在技能市场安装同事共享的版本，或把自己的成功做法整理为个人Skill。让工作经验有一个可以保存、复用和改进的载体。',image:'employee/04-square.png',link:'/docs/employee/04-skills/',tags:['个人与企业Skill','安装与版本管理']},
  {key:'panels',label:'用面板处理业务',title:'适合点选的工作，\n放到自己的业务页面。',text:'查看列表、筛选记录、处理事项。保存个人副本后，用聊天调整布局，预览并保存，让页面更符合自己的工作习惯。',image:'employee/06-panel-home.png',link:'/docs/employee/06-panels/',tags:['企业业务系统','个人面板与预览']}
];
const docs=getDocs();
const featured=docs.filter(d=>['product/digital-twin','architecture/task-lifecycle','insights/design-choices'].includes(d.slug));
---
<SiteLayout pageClass="hive-home">
  <section class="hive-hero container">
    <div class="hive-hero-copy">
      <p class="hive-category"><span class="mini-cell" aria-hidden="true"></span>企业内网中的员工数字分身平台</p>
      <h1><span class="hive-name">蜂巢<span class="brand-stop" aria-hidden="true"></span></span><span class="hive-definition">每位员工的<br/>AI工作空间。</span></h1>
      <p class="hive-hero-description">把资料、方法和业务能力带进自己的空间。<br class="desktop-only"/>让AI做事，也让工作留下积累。</p>
      <div class="hive-actions"><a class="hive-button" href={url('/product/')}>认识蜂巢<Icon name="external" size={21}/></a><a class="hive-secondary" href="#work-demo">看一件具体的工作<Icon name="arrow" size={20}/></a></div>
    </div>
    <HeroWorkspace/>
  </section>
  <div class="hive-statement"><div class="container"><p>各有空间，<br class="statement-break"/>各尽所能。</p><ul><li>独立的员工空间</li><li>可复用的工作方法</li><li>有归属的业务权限</li></ul><span class="statement-brand" aria-hidden="true">HiveOS</span></div></div>

  <section class="hive-work container" id="work-demo">
    <div class="hive-section-heading"><div><p class="hive-section-label">把工作展开</p><h2>先看一件<br/>具体的事。</h2></div><p>整理一份周报，留下一个方法，打开一张业务面板。<br/>从真实界面认识蜂巢，也理解每一步的作用。</p></div>
    <div class="hive-demo" data-tabs>
      <div class="hive-demo-tabs" role="tablist" aria-label="工作场景">{examples.map((example,i)=><button id={'tab-'+example.key} type="button" role="tab" aria-selected={i===0?'true':'false'} aria-controls={'example-'+example.key} tabindex={i===0?0:-1}><Icon name={i===0?'file':i===1?'layers':'grid'} size={23}/><span>{example.label}</span><Icon name="external" size={19}/></button>)}</div>
      {examples.map((example,i)=><div class="hive-demo-panel" id={'example-'+example.key} role="tabpanel" aria-labelledby={'tab-'+example.key} hidden={i!==0}>
        <div class="hive-demo-copy"><div class="hive-demo-tags">{example.tags.map(tag=><span>{tag}</span>)}</div><h3>{example.title.split('\n').map(line=><>{line}<br/></>)}</h3><p>{example.text}</p><a class="hive-text-link" href={url(example.link)}>阅读这项功能的操作手册<Icon name="arrow" size={20}/></a><small>真实产品界面<br/>图中人员与工作资料均为合成教学数据</small></div>
        <figure class="hive-screen"><div class="hive-screen-bar"><span class="mini-cell" aria-hidden="true"></span><span>蜂巢员工工作台</span><small>界面演示</small></div><button type="button" data-image-zoom aria-label={'放大'+example.label+'界面'}><img src={url('/media/manuals/'+example.image)} alt={example.label+'的员工工作台演示界面'} width="1440" height="1100" loading="lazy"/></button><figcaption>点击图片，放大查看操作细节<Icon name="external" size={16}/></figcaption></figure>
      </div>)}
    </div>
  </section>

  <section class="hive-persistence"><div class="container">
    <div class="persistence-copy"><p class="hive-section-label">蜂巢的起点，是员工自己的空间</p><h2>对话会结束。<br/>工作，<br/>接着积累。</h2><p>每名员工拥有自己的持久文件和执行环境。<br/>多段对话共享工作资料；文件、脚本和依赖，<br class="desktop-only"/>不用随每一次任务重新准备。</p><a class="hive-text-link" href={url('/docs/product/digital-twin/')}>理解员工数字分身<Icon name="arrow" size={20}/></a></div>
    <div class="persistence-files"><div class="files-heading"><Icon name="workspace" size={24}/><h3>我的工作空间</h3><span>示意</span></div><div class="files-index">{[{icon:'file',name:'本周工单.csv',use:'带入的资料'},{icon:'file',name:'工单周报.md',use:'留下的成果'},{icon:'code',name:'整理脚本.py',use:'可复用的工具'},{icon:'book',name:'我的周报Skill',use:'积累的工作方法'}].map(item=><div><Icon name={item.icon} size={22}/><strong>{item.name}</strong><span>{item.use}</span></div>)}</div><p>保留文件与方法，下一次可以继续使用。<br/>示意中的文件不代表真实业务记录。</p><span class="files-cell" aria-hidden="true"></span></div>
    <div class="hive-principles"><article><span class="principle-cell" aria-hidden="true"></span><h3>一人，一处空间</h3><p>工作有归属，文件和环境持续保留。每位员工在自己的空间里推进任务。</p></article><article><span class="principle-cell" aria-hidden="true"></span><h3>方法，可以复用</h3><p>Skill保存做法，MCP提供工具。把一次做成的经验，变成下一次的起点。</p></article><article><span class="principle-cell" aria-hidden="true"></span><h3>业务，保有边界</h3><p>蜂巢证明员工身份，业务系统关联账号，并继续决定自己的业务权限。</p></article></div>
  </div></section>

  <section class="hive-architecture"><div class="container"><div class="hive-section-heading"><div><p class="hive-section-label">打开蜂巢</p><h2>看见连接，<br/>也看见边界。</h2></div><div><p>从控制、执行到模型与业务访问，<br/>每一条路径都有自己的职责。</p><a class="hive-text-link" href={url('/architecture/')}>探索架构与设计<Icon name="arrow" size={20}/></a></div></div><ArchitectureGraph/><div class="hive-architecture-notes"><p><strong>控制与执行</strong>Core管理状态，Runtime负责员工工作。</p><p><strong>模型与业务</strong>模型经过网关，业务系统决定自身权限。</p><p><strong>部署范围</strong>面向单企业内网，当前为单节点部署。</p></div></div></section>

  <section class="hive-routes container"><div class="routes-intro"><p class="hive-section-label">让理解变成行动</p><h2>找到你的<br/>那一页。</h2><p>不用从头读完所有内容。<br/>从自己的角色和问题开始。</p><a class="hive-text-link" href={url('/docs/')}>浏览全部{docs.length}篇文档<Icon name="arrow" size={20}/></a><div class="route-cell-cluster" aria-hidden="true"><i></i><i></i><i></i></div></div><div class="route-list">
    <a href={url('/docs/employee/overview/')}><span class="route-role">使用者</span><div><h3>员工工作台</h3><p>从第一次登录，到对话、技能、文件和自动化。<br/>10个使用章节，71张界面截图。</p></div><span class="route-arrow"><Icon name="external" size={27}/></span></a>
    <a href={url('/docs/admin/overview/')}><span class="route-role">管理者</span><div><h3>管理员控制台</h3><p>把人员、模型与企业能力准备好，理解管理的影响。<br/>10个管理章节，60张界面截图。</p></div><span class="route-arrow"><Icon name="external" size={27}/></span></a>
    <a href={url('/developers/')}><span class="route-role">开发者</span><div><h3>连接业务系统</h3><p>开放API、员工身份、Skill、MCP与业务面板。<br/>按接口契约选择适合的接入方式。</p></div><span class="route-arrow"><Icon name="external" size={27}/></span></a>
  </div></section>

  <section class="hive-reading"><div class="container"><div class="hive-section-heading"><div><p class="hive-section-label">把设计讲清楚</p><h2>值得多读一页。</h2></div><a class="hive-text-link" href={url('/library/')}>交流与实践<Icon name="arrow" size={20}/></a></div><div class="hive-article-list">{featured.map(doc=><a href={docUrl(doc)}><span class="article-cell" aria-hidden="true"></span><h3>{doc.title}</h3><p>{doc.description}</p><span class="article-read">{doc.minutes}分钟阅读<Icon name="external" size={22}/></span></a>)}</div></div></section>
  <section class="hive-start container"><div><p class="hive-section-label">了解之后，再开始</p><h2>你的下一步，<br/>可以从这里开始。</h2></div><div><a class="hive-button" href={url('/docs/product/get-started/')}>阅读蜂巢入门路线<Icon name="external" size={22}/></a><p>当前面向单企业内网、单节点部署与受控验证。<br/>正式生产使用仍需结合实际环境完成安全、容量和恢复验证。</p></div></section>
</SiteLayout>
