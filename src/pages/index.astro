---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import HeroWorkspace from '../components/HeroWorkspace.astro';
import ManualDiagram from '../components/ManualDiagram.astro';
import { url } from '../lib/content';
import '../styles/home.css';

const audiences = [
  {
    icon: 'workspace',
    title: '员工工作台',
    summary: '发起第一次对话，引用资料、整理文件，或设置自动化。',
    link: '/docs/employee/overview/',
  },
  {
    icon: 'shield',
    title: '管理员控制台',
    summary: '开通人员，分配知识库、业务系统和工具，查看平台运行。',
    link: '/docs/admin/overview/',
  },
  {
    icon: 'code',
    title: '开发者指南',
    summary: '从开放API、统一身份、工具或业务面板选一种接入方式。',
    link: '/developers/',
  },
];

const examples = [
  {
    key: 'report',
    label: '从资料到周报',
    heroLabel: '员工工作台',
    icon: 'file',
    title: '把零散工单整理成一份周报',
    steps: [
      '附上工单或表格，告诉智能体报告的时间范围和格式。',
      '查看执行过程，核对数字、引用和生成的文件。',
      '下次直接从自己的文件目录打开报告，继续补充。',
    ],
    image: 'employee/02-answer-files.png',
    alt: '员工工作台的对话与生成文件',
    link: '/docs/employee/02-conversations/',
  },
  {
    key: 'files',
    label: '继续已有工作',
    heroLabel: '文件管理',
    icon: 'workspace',
    title: '之前的资料，还在你的文件目录',
    steps: [
      '打开「文件管理」，在自己的目录中找上次保留的材料。',
      '先预览或下载，确认你要用的是正确版本。',
      '需要智能体处理时，在对话中提供文件或说明位置。',
    ],
    image: 'employee/07-files.png',
    alt: '员工工作台的文件管理页面',
    link: '/docs/employee/07-workspace/',
  },
  {
    key: 'panels',
    label: '用面板处理业务',
    heroLabel: '业务面板',
    icon: 'grid',
    title: '把常用的业务操作放进面板',
    steps: [
      '打开获分配的业务面板，按业务系统授予的权限查看和操作。',
      '需要个人调整时，按页面提供的入口保存一份个人副本。',
      '在对话中说明要改的地方，预览结果再保存。',
    ],
    image: 'employee/06-panel-home.png',
    alt: '员工工作台的业务面板入口',
    link: '/docs/employee/06-panels/',
  },
];

const concepts = [
  { icon: 'workspace', title: '自己的文件和执行环境', text: '同一员工的多段对话可继续使用工作空间里的文件、脚本和依赖。', link: '/docs/architecture/workspace/' },
  { icon: 'file', title: '任务需要的资料', text: '把个人文件附到对话，也可以从已分配的知识库引用资料。', link: '/capabilities/' },
  { icon: 'book', title: '可以复用的做法', text: 'Skill是一份给智能体用的操作说明。MCP是一种让智能体连接工具的方式。', link: '/docs/employee/04-skills/' },
  { icon: 'shield', title: '属于员工的业务权限', text: '蜂巢证明是谁在发起操作。业务系统根据自己的账号和授权判断能做什么。', link: '/docs/developers/identity/' },
];
---
<SiteLayout>
  <div class="home-page">
    <div class="home-top">
      <section class="home-hero container" aria-labelledby="home-title">
        <div class="home-hero-intro">
          <div>
            <p class="hero-category">企业内网 · 员工数字分身</p>
            <h1 id="home-title">每个人的AI，<br />都有自己的<span>工作空间。</span></h1>
          </div>
          <div class="home-hero-copy">
            <p class="home-hero-description">在同一个工作台里，用自己的资料开始对话，让智能体使用获准的工具，留下下次还能打开的文件。</p>
            <div class="button-row">
              <a class="button home-primary" href={url('/handbooks/')}><Icon name="book" size={19} />阅读操作手册</a>
              <a class="button home-secondary" href={url('/capabilities/')}>查看功能架构图</a>
            </div>
          </div>
        </div>
        <HeroWorkspace scenes={examples} />
      </section>
    </div>

    <nav class="home-audiences container" aria-label="按角色开始">
      {audiences.map(audience => (
        <a class="role-link" href={url(audience.link)}>
          <Icon name={audience.icon} size={22} />
          <span><strong>{audience.title}</strong><small>{audience.summary}</small></span>
          <Icon name="chevron" size={19} />
        </a>
      ))}
    </nav>

    <section id="examples" class="home-work section container" aria-labelledby="examples-title">
      <div class="home-heading">
        <div><p class="section-label">使用场景</p><h2 id="examples-title">一次工作，<span>从交代到交付</span></h2></div>
        <p>试着从一件熟悉的事开始。你可以把工作过程和文件留下来，后续直接接着做。</p>
      </div>
      <div class="work-showcase" data-tabs="gallery">
        <div class="work-toolbar">
          <div class="work-tabs" role="tablist" aria-label="工作场景" aria-orientation="horizontal">
            {examples.map((example, index) => (
              <button id={'tab-' + example.key} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={'example-' + example.key} tabindex={index === 0 ? 0 : -1}>
                <Icon name={example.icon} size={19} />{example.label}
              </button>
            ))}
          </div>
          <div class="work-controls" role="group" aria-label="浏览工作场景">
            <button type="button" data-tab-step="-1" aria-label="上一个工作场景" aria-controls="work-panels">
              <Icon name="chevron" size={18} />
            </button>
            <span class="work-position" role="status" data-tab-position>1 / {examples.length}</span>
            <button type="button" data-tab-step="1" aria-label="下一个工作场景" aria-controls="work-panels">
              <Icon name="chevron" size={18} />
            </button>
          </div>
        </div>
        <div class="work-panels" id="work-panels">
          {examples.map((example, index) => (
            <div class="work-panel" id={'example-' + example.key} role="tabpanel" aria-labelledby={'tab-' + example.key} hidden={index !== 0}>
              <figure class="work-screen">
                <button type="button" data-image-zoom aria-label={'放大' + example.alt}>
                  <img src={url('/media/manuals/' + example.image)} width="1440" height="1100" alt={example.alt} loading="lazy" decoding="async" />
                  <span class="zoom-label" aria-hidden="true"><Icon name="search" size={15} />放大查看</span>
                </button>
                <figcaption>真实界面 · 合成示例</figcaption>
              </figure>
              <div class="work-copy">
                <h3>{example.title}</h3>
                <ol>{example.steps.map(step => <li>{step}</li>)}</ol>
                <a class="inline-link" href={url(example.link)}>查看操作步骤</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="home-foundation" aria-labelledby="foundation-title">
      <div class="container foundation-grid">
        <div class="foundation-intro">
          <p class="section-label">认识蜂巢</p>
          <h2 id="foundation-title">为什么叫<br />员工数字分身</h2>
          <p>它在员工自己的工作空间里处理任务，使用已获准的能力，并保留可以继续使用的资料和成果。</p>
          <a class="inline-link" href={url('/docs/product/digital-twin/')}>了解数字分身</a>
        </div>
        <div class="foundation-concepts">
          {concepts.map(concept => (
            <article>
              <Icon name={concept.icon} size={24} />
              <div>
                <h3><a href={url(concept.link)}>{concept.title}</a></h3>
                <p>{concept.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section container" id="workspace-continuity" aria-labelledby="continuity-title">
      <ManualDiagram name="workspace-continuity">
        <a class="inline-link" href={url('/docs/employee/07-workspace/')}>查看工作空间和文件管理</a>
      </ManualDiagram>
    </section>

    <section class="home-next" aria-labelledby="next-title">
      <div class="container home-next-inner">
        <div><h2 id="next-title">准备开始使用蜂巢？</h2><p>蜂巢面向单企业内网。先确认你的部署已开通哪些功能，再按入门路线开始。</p></div>
        <div class="button-row">
          <a class="button home-primary" href={url('/docs/product/get-started/')}>阅读入门路线</a>
          <a class="button home-secondary" href={url('/docs/')}>打开文档中心</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
