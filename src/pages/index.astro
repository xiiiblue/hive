---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import HeroWorkspace from '../components/HeroWorkspace.astro';
import ManualDiagram from '../components/ManualDiagram.astro';
import { url } from '../lib/content';
import '../styles/home.css';

const examples = [
  {
    key: 'report',
    label: '从资料到周报',
    heroLabel: '员工工作台',
    windowUrl: 'hive / 对话 / 演示工单周报',
    icon: 'file',
    kicker: '对话与过程核对',
    title: '把零散工单整理成一份可核对的周报',
    steps: [
      '附上工单表格或引用知识库资料，说明时间范围与输出格式。',
      '展开思考过程与工具调用，逐项核对统计数字、来源和生成文件。',
      '报告留在个人工作目录，下周在新对话中读取原模板继续更新。',
    ],
    image: 'employee/02-answer-files.png',
    alt: '员工工作台的对话与生成文件',
    link: '/docs/employee/02-conversations/',
  },
  {
    key: 'files',
    label: '继续已有工作',
    heroLabel: '文件管理',
    windowUrl: 'hive / 工作空间 / 文件',
    icon: 'workspace',
    kicker: '持久目录与共享空间',
    title: '上次留下的材料与脚本，始终在你的目录里',
    steps: [
      '打开文件管理，查看个人主目录与获分配的团队共享目录。',
      '在线预览Markdown、表格或代码，下载交付件，确认当前版本。',
      '在任意新对话中用 @ 引用已有路径，无需每次重新上传。',
    ],
    image: 'employee/07-files.png',
    alt: '员工工作台的文件管理页面',
    link: '/docs/employee/07-workspace/',
  },
  {
    key: 'panels',
    label: '用面板处理业务',
    heroLabel: '业务面板',
    windowUrl: 'hive / 面板 / 工单看板',
    icon: 'grid',
    kicker: '业务页面与个人定制',
    title: '把高频业务查询与操作放进可视化面板',
    steps: [
      '从导航打开获分配的业务面板，按本人业务系统权限查看与办理。',
      '需要调整筛选或布局时，一键另存为个人面板副本。',
      '在对话栏说明修改要求，预览无误后再保存生效。',
    ],
    image: 'employee/06-panel-home.png',
    alt: '员工工作台的业务面板入口',
    link: '/docs/employee/06-panels/',
  },
];

const steps = [
  { n: '01', title: '提出要求', text: '在网页、手机或已绑定的企微、钉钉、飞书机器人里描述任务，附上资料。' },
  { n: '02', title: '在自己的空间执行', text: '智能体在你独占的运行环境中读写文件、调用Skill、MCP工具和获准业务系统。' },
  { n: '03', title: '核对并沉淀', text: '查看完整过程与产出文件；验证过的做法保存为个人Skill，下次直接复用。' },
];
---
<SiteLayout>
  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-aurora" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="hero-pill"><i></i>企业内网 · 员工数字分身平台</span>
          <h1 id="home-title">每位员工，<br />都有一个<span class="hl">记得住事</span>的AI搭档</h1>
          <p class="hero-lead">蜂巢为每个人提供独立、持久的AI工作空间。文件、脚本和做法跨对话保留，业务权限仍由原系统把关——今天的成果，明天接着用。</p>
          <div class="button-row">
            <a class="button primary" href={url('/docs/product/get-started/')}>开始了解<Icon name="arrow" size={17} /></a>
            <a class="button" href={url('/handbooks/')}><Icon name="book" size={17} />操作手册</a>
          </div>
          <dl class="hero-stats">
            <div><dt>62</dt><dd>项平台功能</dd></div>
            <div><dt>2</dt><dd>种执行引擎</dd></div>
            <div><dt>5</dt><dd>类消息渠道</dd></div>
          </dl>
        </div>
        <div class="hero-visual home-hero">
          <HeroWorkspace scenes={examples} />
        </div>
      </div>
    </section>

    <section class="section container" aria-labelledby="bento-title">
      <div class="center-heading">
        <span class="eyebrow">为什么是蜂巢</span>
        <h2 id="bento-title">不是又一个聊天框，<br />而是一个能积累的工作环境</h2>
      </div>
      <div class="bento">
        <a class="bento-card b-wide b-mint" href={url('/docs/architecture/workspace/')}>
          <span class="b-icon"><Icon name="workspace" size={22} /></span>
          <h3>独立、持久的工作空间</h3>
          <p>每人一个主目录与独占运行环境。上周的周报模板、装好的依赖、写好的脚本，下一次对话里都还在；团队共享目录支持多人协作。</p>
          <div class="b-files" aria-hidden="true">
            <span>~/reports/工单周报.md</span><span>~/scripts/stat.py</span><span>/shared/客服组/</span>
          </div>
        </a>
        <a class="bento-card b-indigo" href={url('/docs/employee/04-skills/')}>
          <span class="b-icon"><Icon name="book" size={22} /></span>
          <h3>做法沉淀成Skill</h3>
          <p>把验证过的步骤保存为个人Skill，或从技能市场安装企业发布的版本，连接MCP远程工具与岗位知识库。</p>
        </a>
        <a class="bento-card b-sky" href={url('/docs/employee/05-systems-and-channels/')}>
          <span class="b-icon"><Icon name="layers" size={22} /></span>
          <h3>多渠道随处发起</h3>
          <p>除电脑与手机网页外，支持绑定企微、微信、钉钉、飞书与Telegram个人机器人。</p>
          <div class="b-chips" aria-hidden="true"><span>企微</span><span>钉钉</span><span>飞书</span><span>微信</span><span>TG</span></div>
        </a>
        <a class="bento-card" href={url('/docs/employee/03-automation/')}>
          <span class="b-icon"><Icon name="check" size={22} /></span>
          <h3>定时与来信自动化</h3>
          <p>验证好的工作流可设成定时计划或个人邮箱来信规则自动触发，历史状态随时可查。</p>
        </a>
        <a class="bento-card" href={url('/docs/employee/06-panels/')}>
          <span class="b-icon"><Icon name="grid" size={22} /></span>
          <h3>可视化业务面板</h3>
          <p>把高频查询与审批做成静态面板直连业务接口；员工可另存个人副本并用对话微调视图。</p>
        </a>
        <a class="bento-card b-full b-dark" href={url('/docs/developers/identity/')}>
          <div class="b-dark-main">
            <span class="b-icon"><Icon name="shield" size={22} /></span>
            <div>
              <h3>平台验明身份，业务系统管授权</h3>
              <p>蜂巢不托管员工业务密码。访问外部系统时签发短期员工身份，由目标系统按自有账号与角色决定能看什么、能改什么。</p>
            </div>
          </div>
          <div class="b-trust-chain" aria-hidden="true">
            <span>员工本人登录</span><i>→</i><span>蜂巢签发短期身份</span><i>→</i><span>业务系统核验授权</span>
          </div>
        </a>
      </div>
    </section>

    <section class="flow-band" aria-labelledby="flow-title">
      <div class="container">
        <div class="center-heading">
          <span class="eyebrow">工作方式</span>
          <h2 id="flow-title">三步完成工作，把成果留下来</h2>
        </div>
        <ol class="flow-steps">
          {steps.map(s => (
            <li><span class="flow-n">{s.n}</span><h3>{s.title}</h3><p>{s.text}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section id="examples" class="home-work section container" aria-labelledby="examples-title">
      <div class="center-heading">
        <span class="eyebrow">真实界面</span>
        <h2 id="examples-title">看看日常工作在蜂巢里的样子</h2>
        <p>截图来自真实运行的界面与合成演示数据。</p>
      </div>
      <div class="work-showcase" data-tabs="gallery">
        <div class="work-toolbar">
          <div class="work-tabs" role="tablist" aria-label="工作场景" aria-orientation="horizontal">
            {examples.map((example, index) => (
              <button id={'tab-' + example.key} type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-controls={'example-' + example.key} tabindex={index === 0 ? 0 : -1}>
                <Icon name={example.icon} size={18} />{example.label}
              </button>
            ))}
          </div>
          <div class="work-controls" role="group" aria-label="浏览工作场景">
            <button type="button" data-tab-step="-1" aria-label="上一个工作场景" aria-controls="work-panels"><Icon name="chevron" size={18} /></button>
            <span class="work-position" role="status" data-tab-position>1 / {examples.length}</span>
            <button type="button" data-tab-step="1" aria-label="下一个工作场景" aria-controls="work-panels"><Icon name="chevron" size={18} /></button>
          </div>
        </div>
        <div class="work-panels" id="work-panels">
          {examples.map((example, index) => (
            <div class="work-panel" id={'example-' + example.key} role="tabpanel" aria-labelledby={'tab-' + example.key} hidden={index !== 0}>
              <div class="work-copy">
                <span class="work-kicker">{example.kicker}</span>
                <h3>{example.title}</h3>
                <ol>{example.steps.map(step => <li>{step}</li>)}</ol>
                <a class="inline-link" href={url(example.link)}>查看完整操作步骤<Icon name="arrow" size={16} /></a>
              </div>
              <figure class="work-screen">
                <button type="button" data-image-zoom aria-label={'放大' + example.alt}>
                  <img src={url('/media/manuals/' + example.image)} width="1440" height="1100" alt={example.alt} loading="lazy" decoding="async" />
                  <span class="zoom-label" aria-hidden="true"><Icon name="search" size={15} />放大查看</span>
                </button>
                <figcaption>真实界面 · 合成示例</figcaption>
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section container" id="workspace-continuity" aria-labelledby="continuity-title">
      <ManualDiagram name="workspace-continuity">
        <a class="inline-link" href={url('/docs/employee/07-workspace/')}>查看工作空间和文件管理<Icon name="arrow" size={16} /></a>
      </ManualDiagram>
    </section>

    <section class="section container roles" aria-labelledby="roles-heading">
      <div class="center-heading">
        <span class="eyebrow">从这里开始</span>
        <h2 id="roles-heading">按你的角色找到入口</h2>
      </div>
      <nav class="role-grid" aria-label="按角色开始">
        <a class="role-card" href={url('/docs/employee/overview/')}>
          <span class="b-icon"><Icon name="person" size={22} /></span>
          <strong>我是员工</strong><small>对话、文件、Skill、业务面板与自动化</small><span class="role-go">员工手册<Icon name="arrow" size={16} /></span>
        </a>
        <a class="role-card" href={url('/docs/admin/overview/')}>
          <span class="b-icon"><Icon name="shield" size={22} /></span>
          <strong>我是管理员</strong><small>账号、能力组、模型与费用、运行与备份</small><span class="role-go">管理员手册<Icon name="arrow" size={16} /></span>
        </a>
        <a class="role-card" href={url('/developers/')}>
          <span class="b-icon"><Icon name="code" size={22} /></span>
          <strong>我是开发者</strong><small>开放API、统一身份、MCP与HiveBridge</small><span class="role-go">对接指南<Icon name="arrow" size={16} /></span>
        </a>
      </nav>
    </section>

    <section class="home-next" aria-labelledby="next-title">
      <div class="container home-next-inner">
        <h2 id="next-title">准备好在企业内网中试试蜂巢了吗？</h2>
        <p>蜂巢面向单企业内网单节点部署。先确认所在环境已开通的能力，再跟着入门路线完成第一个小任务。</p>
        <div class="button-row">
          <a class="button primary" href={url('/docs/product/get-started/')}>阅读入门路线<Icon name="arrow" size={17} /></a>
          <a class="button" href={url('/capabilities/')}>浏览功能架构</a>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
