---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { getDocs, sections, sectionDocs, docUrl, renderDoc, url, type Doc } from '../../lib/content';
import '../../styles/reading.css';

export function getStaticPaths() {
  return getDocs().map(doc => ({ params: { slug: doc.slug }, props: { doc } }));
}

interface Props { doc: Doc; }

const { doc } = Astro.props;
const { html, headings } = renderDoc(doc.body);
const section = sections.find(item => item.id === doc.section)!;
const list = sectionDocs(doc.section);
const index = list.findIndex(item => item.slug === doc.slug);
const previous = list[index - 1];
const next = list[index + 1];
const diagram = doc.slug === 'product/capabilities' ? url('/media/diagrams/capabilities.html') : undefined;
---
<SiteLayout title={doc.title + ' · 蜂巢文档'} description={doc.description} kind="article">
  <div class="reading-progress" aria-hidden="true"></div>
  <div class="docs-shell">
    <aside class="doc-sidebar" aria-label="文档章节">
      <a class="back-to-docs" href={url('/docs/')}>文档中心</a>
      {sections.map(group => (
        <details class="sidebar-section" open={group.id === doc.section}>
          <summary>{group.title}<Icon name="chevron" size={14} /></summary>
          <nav aria-label={group.title}>
            {sectionDocs(group.id).map(item => (
              <a href={docUrl(item)} aria-current={item.slug === doc.slug ? 'page' : undefined} class:list={{ selected: item.slug === doc.slug }}>{item.title}</a>
            ))}
          </nav>
        </details>
      ))}
    </aside>
    <div class="doc-main">
      <article>
        <header class="doc-heading">
          <nav class="breadcrumbs" aria-label="文档位置">
            <a href={url('/docs/')}>文档中心</a><Icon name="chevron" size={13} /><a href={url('/docs/#' + section.id)}>{section.title}</a>
          </nav>
          <h1>{doc.title}</h1>
          <p>{doc.description}</p>
          <div class="doc-meta">
            <time datetime={doc.updated}>更新于 {doc.updated}</time>
            <span>约{doc.minutes}分钟阅读</span>
            <button type="button" data-print-page>打印本页</button>
          </div>
          {['employee', 'admin'].includes(doc.section) && (
            <div class="doc-notice"><Icon name="book" size={18} /><span>截图使用真实界面和合成示例。实际操作以所在企业的部署为准。</span></div>
          )}
        </header>
        <div class="doc-compact-navigation">
          <details class="mobile-doc-nav">
            <summary>浏览同册章节<Icon name="chevron" size={16} /></summary>
            <nav aria-label={section.title}>
              {list.map(item => <a href={docUrl(item)} aria-current={item.slug === doc.slug ? 'page' : undefined}>{item.title}</a>)}
            </nav>
          </details>
          {headings.length > 0 && (
            <details class="compact-toc">
              <summary>本页目录<Icon name="chevron" size={16} /></summary>
              <nav aria-label="本页目录">
                {headings.map(heading => <a href={'#' + heading.id} class:list={{ sub: heading.depth === 3 }}>{heading.text}</a>)}
              </nav>
            </details>
          )}
        </div>
        <div class="doc-content prose">
          {diagram && (
            <div class="capabilities-diagram">
              <div class="diagram-toolbar"><strong>功能架构图</strong><a href={diagram} target="_blank" rel="noopener">在新窗口打开</a></div>
              <iframe src={diagram} title="蜂巢功能架构与功能目录" height="880" />
            </div>
          )}
          <Fragment set:html={html} />
        </div>
        <footer class="doc-end">
          <a href="https://github.com/xiiiblue/hive/issues">反馈文档问题<Icon name="external" size={15} /></a>
        </footer>
        <nav class="chapter-pagination" aria-label="前后章节">
          {previous ? <a href={docUrl(previous)}><small>上一篇</small><strong>{previous.title}</strong></a> : <span />}
          {next ? <a href={docUrl(next)}><small>下一篇</small><strong>{next.title}</strong></a> : <span />}
        </nav>
      </article>
    </div>
    {headings.length > 0 && (
      <aside class="doc-toc" aria-label="本页目录">
        <span>本页目录</span>
        <nav>{headings.map(heading => <a href={'#' + heading.id} class:list={{ sub: heading.depth === 3 }}>{heading.text}</a>)}</nav>
        <a class="toc-top" href="#main-content">返回顶部</a>
      </aside>
    )}
  </div>
  <script>
    document.querySelector('[data-print-page]')?.addEventListener('click', () => window.print());
    for (const link of document.querySelectorAll('.compact-toc a')) {
      link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
    }
  </script>
</SiteLayout>
