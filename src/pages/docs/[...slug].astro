---
import SiteLayout from '../../layouts/SiteLayout.astro';import Icon from '../../components/Icon.astro';import {getDocs,sections,sectionDocs,docUrl,renderDoc,url,type Doc} from '../../lib/content';
export function getStaticPaths(){return getDocs().map(doc=>({params:{slug:doc.slug},props:{doc}}));}
interface Props {doc:Doc;}
const {doc}=Astro.props;const {html,headings}=renderDoc(doc.body);const section=sections.find(s=>s.id===doc.section)!;const list=sectionDocs(doc.section);const index=list.findIndex(d=>d.slug===doc.slug);const previous=list[index-1],next=list[index+1];
---
<SiteLayout title={doc.title+' · 蜂巢文档'} description={doc.description} kind="article"><div class="reading-progress" aria-hidden="true"></div><div class="docs-shell"><aside class="doc-sidebar" aria-label="文档章节"><a class="back-to-docs" href={url('/docs/')}><span>←</span> 文档中心</a>{sections.map(group=><details class="sidebar-section" open={group.id===doc.section}><summary>{group.title}<Icon name="chevron" size={14}/></summary><nav aria-label={group.title}>{sectionDocs(group.id).map((item,index)=><a href={docUrl(item)} aria-current={item.slug===doc.slug?'page':undefined} class:list={{selected:item.slug===doc.slug}}>{item.slug.endsWith('/overview')?'':String(index).padStart(2,'0')+' '}{item.title}</a>)}</nav></details>)}<div class="sidebar-note">持续补充的公开文档<br/><a href="https://github.com/xiiiblue/hive">查看网站源码 ↗</a></div></aside><div class="doc-main"><details class="mobile-doc-nav"><summary>浏览{section.title}章节<Icon name="chevron" size={16}/></summary>{list.map(item=><a href={docUrl(item)} aria-current={item.slug===doc.slug?'page':undefined}>{item.title}</a>)}</details><article><header class="doc-heading"><div class="breadcrumbs"><a href={url('/docs/')}>文档</a><span>/</span><a href={docUrl(list[0])}>{section.title}</a></div><h1>{doc.title}</h1><p>{doc.description}</p><div class="doc-meta"><span>更新于 {doc.updated}</span><span>约{doc.minutes}分钟阅读</span><button type="button" data-print-page>打印本页<Icon name="external" size={13}/></button></div>{['employee','admin'].includes(doc.section)&&<div class="doc-notice"><Icon name="book" size={17}/><span>截图使用真实界面和合成教学数据；实际操作以所在企业部署为准。</span></div>}</header><div class="doc-content prose" set:html={html}/><footer class="doc-end"><span>本文按当前产品行为整理，演示不代表真实业务已执行。</span><a href="https://github.com/xiiiblue/hive/issues">反馈文档问题<Icon name="external" size={14}/></a></footer><nav class="chapter-pagination" aria-label="前后章节">{previous?<a href={docUrl(previous)}><small>← 上一篇</small><strong>{previous.title}</strong></a>:<span/>}{next?<a href={docUrl(next)}><small>下一篇 →</small><strong>{next.title}</strong></a>:<span/>}</nav></article></div><aside class="doc-toc" aria-label="本页目录"><span>本页内容</span><nav>{headings.map(h=><a href={'#'+h.id} class:list={{sub:h.depth===3}}>{h.text}</a>)}</nav><a class="toc-top" href="#main-content">返回顶部 ↑</a></aside></div><script>document.querySelector('[data-print-page]')?.addEventListener('click',()=>window.print());</script></SiteLayout>
