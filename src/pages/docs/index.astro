---
import SiteLayout from '../../layouts/SiteLayout.astro';import Icon from '../../components/Icon.astro';import {sections,sectionDocs,getDocs,docUrl} from '../../lib/content';
const docs=getDocs();
---
<SiteLayout title="文档中心 · 蜂巢" description="按角色和主题查阅蜂巢产品、架构、员工手册、管理员手册与开发对接指南。"><section class="page-intro container"><span class="eyebrow">THE HIVEOS LIBRARY</span><h1>知道去哪里找答案，<br/><em>也是工作的开始。</em></h1><div class="page-intro-bottom"><p>从产品概念到具体操作，从架构原理到系统接入。<br/>按你的角色阅读，或直接搜索一个问题。</p><button class="button primary" type="button" data-open-search><Icon name="search" size={18}/>搜索全部正文</button></div></section><section class="container docs-index"><div class="library-summary"><span>{docs.length}篇文档</span><span>6个主题</span><span>133张界面与概念配图</span><span>持续更新</span></div>{sections.map((section,i)=><section class="doc-index-section" id={section.id}><div class="doc-index-heading"><span class="index-number">0{i+1}</span><h2>{section.title}</h2><p>{section.description}</p><small>{sectionDocs(section.id).length}篇</small></div><div class="doc-index-list">{sectionDocs(section.id).map((doc,index)=><a href={docUrl(doc)}><span>{doc.slug.endsWith('/overview')?'导读':String(index).padStart(2,'0')}</span><div><strong>{doc.title}</strong><p>{doc.description}</p></div><small>{doc.minutes}分钟</small><Icon name="arrow" size={18}/></a>)}</div></section>)}</section></SiteLayout>
