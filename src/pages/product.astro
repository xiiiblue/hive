---
import SiteLayout from '../layouts/SiteLayout.astro';import Icon from '../components/Icon.astro';import WorkspaceIllustration from '../components/WorkspaceIllustration.astro';import DocCards from '../components/DocCards.astro';import {url,sectionDocs} from '../lib/content';
---
<SiteLayout title="产品与场景 · 蜂巢" description="理解蜂巢员工数字分身，了解持续工作空间、技能复用、企业系统连接和适用场景。"><section class="page-intro container"><span class="eyebrow">PRODUCT / 工作有了连续性</span><h1>一位员工，<br/><em>一处长期工作的空间。</em></h1><p>蜂巢是部署在单个企业内网中的员工数字分身平台。<br/>让智能体使用员工的资料、方法和已获准业务能力，持续推进工作。</p></section><section class="container product-overview"><WorkspaceIllustration/><div><span class="eyebrow">WHAT MAKES A DIGITAL TWIN</span><h2>数字分身，<br/>从“我是谁”开始。</h2><p>它由员工身份、持久文件、执行环境、对话和获分配的能力共同组成。你可以继续上一项工作，也可以积累自己的做法。</p><p>蜂巢提供身份与平台能力；业务账号和操作权限仍由业务系统管理。它不创建一个能够代替所有员工的高权限账号。</p><a class="inline-link" href={url('/docs/product/digital-twin/')}>理解核心对象与关系<Icon name="arrow" size={18}/></a></div></section><section class="section container"><div class="section-heading"><div><span class="eyebrow">EVERYDAY SCENARIOS</span><h2>从熟悉的工作，<br/>找到合适的起点。</h2></div><a class="inline-link" href={url('/docs/product/scenarios/')}>阅读场景指南<Icon name="arrow" size={18}/></a></div><div class="scenario-list">{[{n:'01',title:'把分散资料整理成报告',text:'上传工单、纪要或表格，写清时间范围和格式，核对数字和来源，再保留结果文件。',tags:'对话 · 文件 · 结果核对',link:'/docs/employee/02-conversations/'},{n:'02',title:'把成功的方法留给下一次',text:'从技能广场选择做法，或把自己的处理过程整理为Skill。安装、启用、版本和权限分别管理。',tags:'个人Skill · 企业Skill · 技能市场',link:'/docs/employee/04-skills/'},{n:'03',title:'让重复工作按时开展',text:'先在普通对话中确认工作方式，再设置定时任务，查看执行历史和失败提醒。',tags:'自动化 · 专用对话 · 执行历史',link:'/docs/employee/03-automation/'},{n:'04',title:'让业务页面更符合自己的习惯',text:'从业务面板查看列表与处理事项，保存个人副本，用聊天调整页面，再预览和保存版本。',tags:'业务面板 · 个人副本 · 草稿预览',link:'/docs/employee/06-panels/'}].map(item=><a href={url(item.link)}><span>{item.n}</span><h3>{item.title}<small>{item.tags}</small></h3><p>{item.text}</p><Icon name="external" size={24}/></a>)}</div></section><section class="section principles"><div class="container"><div class="section-heading"><div><span class="eyebrow">CAPABILITY WITH BOUNDARIES</span><h2>用得起来，<br/>也说得清楚。</h2></div><p>能力、身份、权限与结果，<br/>需要分别理解。</p></div><div class="boundary-grid"><article><h3>内网部署</h3><p>平台部署在企业自己的环境中。模型上游与业务系统连接仍可能涉及外部网络，数据范围需要按实际部署核对。</p></article><article><h3>原生工作方式</h3><p>智能体可以使用文件、Shell、脚本、CLI和Skill，不必把每个业务动作改写成平台专用工具。</p></article><article><h3>结果需要核对</h3><p>任务完成表示智能体执行已结束。业务是否成功、取消是否来得及，以及已发生的修改，都要按实际结果判断。</p></article></div></div></section><section class="section container"><div class="section-heading"><h2>继续认识蜂巢。</h2></div><DocCards docs={sectionDocs('product')}/></section></SiteLayout>
