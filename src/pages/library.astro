---
import SiteLayout from '../layouts/SiteLayout.astro';
import DocCards from '../components/DocCards.astro';
import Icon from '../components/Icon.astro';
import { url, sectionDocs } from '../lib/content';

const projects = [
  {
    name: 'ACDL',
    category: '协同研发方法',
    description: '让人与Agent围绕同一个目标协作。从说清需求、确定设计，到完成改动并验证结果。',
    action: '查看ACDL手册',
    href: 'https://www.bluexiii.com/acdl/',
  },
  {
    name: 'HiveFlow',
    category: '自动化开发流水线',
    description: '把开发者反馈接到问题调查、开发验证与交付回执，让提出问题的人查得到处理结果。',
    action: '查看HiveFlow案例',
    href: 'https://www.bluexiii.com/flow/',
  },
];
---
<SiteLayout title="研发实践 · 蜂巢" description="了解蜂巢如何用ACDL组织研发、用HiveFlow处理反馈，并阅读产品设计与业务接入案例。">
  <section class="page-intro container">
    <h1>研发实践</h1>
    <p>了解蜂巢团队怎样与Agent协作研发，怎样把开发者反馈跟进到交付。</p>
  </section>
  <div class="container doc-card-grid practice-projects">
    {projects.map(({ name, category, description, action, href }) => (
      <a class="doc-card" data-reveal data-spotlight href={href}>
        <span class="card-kicker">{category}</span>
        <h2>{name}</h2>
        <p>{description}</p>
        <span class="card-bottom">{action}<Icon name="external" size={17} /></span>
      </a>
    ))}
  </div>
  <section class="section container">
    <div class="section-heading"><h2>交流文章</h2></div>
    <DocCards docs={sectionDocs('insights')} />
  </section>
  <section class="end-note container" data-reveal>
    <p>现有交流材料按当前产品重新整理。历史演示、设计意图与真实环境验证各有适用范围，不能互相替代。</p>
    <a class="inline-link" href={url('/docs/')}>回到文档中心<Icon name="arrow" size={17} /></a>
  </section>
</SiteLayout>

<style>
  @media (min-width: 761px) {
    .practice-projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
